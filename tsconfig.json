{
  // Visit https://aka.ms/tsconfig to read more about this file
  // Este archivo le indica a TypeScript cómo compilar el proyecto.
  "compilerOptions": {
    // === Estructura de carpetas ===
    // Carpeta con el código fuente que escribimos (archivos .ts)
     "rootDir": "./src",
    // Carpeta donde TypeScript deja el código ya convertido a JavaScript (.js)
     "outDir": "./dist",

    // === Entorno de ejecución ===
    // Sistema de módulos. "nodenext" sigue las reglas actuales de Node.js:
    // usa import/export o require según el campo "type" de package.json.
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    // Versión de JavaScript a la que se convierte el código. "esnext" = la más reciente
    "target": "esnext",
    // Tipos globales que se cargan. ["node"] agrega los tipos de Node.js (process, etc.)
    "types": ["node"],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // === Archivos extra que genera la compilación ===
    // Genera .js.map: permite que el depurador muestre el código .ts original
    "sourceMap": true,
    // Genera archivos .d.ts: describen los tipos de nuestro código para otros proyectos
    "declaration": true,
    // Genera .d.ts.map: enlaza cada tipo con su línea en el código .ts
    "declarationMap": true,

    // === Chequeos de tipos más estrictos ===
    // Si leemos arr[0] o obj[clave], TypeScript exige revisar que el valor exista (puede ser undefined)
    "noUncheckedIndexedAccess": true,
    // Una propiedad opcional (con ?) puede faltar, pero no puede valer undefined explícitamente
    "exactOptionalPropertyTypes": true,

    // Opciones de estilo que están desactivadas (quitá los // para activarlas)
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // === Opciones recomendadas ===
    // Activa un conjunto de chequeos estrictos de tipos. Es lo más recomendable dejarlo en true
    "strict": true,
    // Solo sirve para React (JSX). En este proyecto no se usa y podría quitarse
    "jsx": "react-jsx",
    // Obliga a escribir import/export tal como se ejecutan. Con CommonJS no permite "import"
    "verbatimModuleSyntax": true,
    // Exige que cada archivo se pueda compilar por sí solo (lo necesitan herramientas como tsx)
    "isolatedModules": true,
    // Revisa que existan los módulos de los imports sin nombres, como import 'dotenv/config'
    "noUncheckedSideEffectImports": true,
    // Trata todo archivo como módulo aunque no tenga import/export
    "moduleDetection": "force",
    // No revisa los tipos dentro de node_modules: la compilación es más rápida
    "skipLibCheck": true,
  }
}
